{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "headers": [
        {
            "source": "/assets/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "source": "/(.*\\.(?:png|jpg|jpeg|gif|svg|webp|avif|ico|mp4|webm|woff|woff2|webmanifest))",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=14400"
                }
            ]
        }
    ]
}
